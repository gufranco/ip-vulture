{
  "name": "ip-vulture",
  "version": "1.0.0",
  "description": "Captures incoming request IPs and resolves geolocation via ip-api.com",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env --import tsx src/server.ts",
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "local": "./scripts/local.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^25.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.{ts,js,json}": "biome check --write"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
