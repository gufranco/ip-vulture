PORT=3000
HOST=0.0.0.0

# false, a hop count such as 1, or a comma-separated CIDR list.
# Leave false unless a proxy or tunnel sits in front of this process.
TRUST_PROXY=false

# A simulation id from the catalogue, or random.
SERVER_TEMPLATE=apache
# startup picks once per process, request picks per request.
RANDOM_SCOPE=startup
# Narrow random selection. Era: 1990s, 2000s, 2010s, 2020s. Genre: vendor, creative.
SIMULATION_ERA=
SIMULATION_GENRE=
# header, comment, both, or off.
SIMULATION_DISCLOSURE=both

HEALTH_ENABLED=true
HEALTH_PATH=/__health

RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_MS=60000

REQUEST_TIMEOUT_MS=30000
CONNECTION_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=5000
BODY_LIMIT=1048576

ACCESS_LOG_CAPACITY=1000
# Which classifications to store and to alert on.
# Values: human, bot, scanner, blocked.
RECORD_POLICY=human,bot,scanner
ALERT_POLICY=human

IP_ALLOWLIST=
IP_BLOCKLIST=

FEEDS_ENABLED=true
# Refuse to start when every feed fails. Leave false so an offline machine boots.
FEEDS_REQUIRED=false
FEEDS=
FEEDS_STARTUP_TIMEOUT_MS=30000
FEEDS_TIMEOUT_MS=15000
FEEDS_REFRESH_MINUTES=720
FEEDS_MAX_BYTES=20971520

# Sends the caller address to a third party. Off by default.
GEO_ENABLED=false
GEO_TIMEOUT_MS=5000
GEO_BUDGET_PER_MINUTE=40
GEO_CACHE_TTL_SECONDS=3600
GEO_CACHE_MAX=5000

ADMIN_ENABLED=false
ADMIN_PATH=/__admin
ADMIN_USER=
ADMIN_PASSWORD=

ALERT_ENABLED=false
ALERT_WINDOW_SECONDS=60
ALERT_MAX_PER_HOUR=20
# Records held per window. Older ones are counted and omitted from the digest.
ALERT_MAX_QUEUED=500
ALERT_FROM=
ALERT_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
